rule qiime_taxa_collapse:
	input:
		table  = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_table.qza",

		taxonomy = "results/{APLICON_TYPE}/qiime_diversity/{APLICON_TYPE}_taxonomy.qza"
	output:
		table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_collapsed_{P_LEVEL}_table.qza"
	log:
		"logs/qiime_ancom/{APLICON_TYPE}_level_{P_LEVEL}_table.log"
	params:
		 p_level = P_LEVEL
	shell:
		"qiime taxa collapse --i-table {input.table} --i-taxonomy {input.taxonomy} --p-level {params.p_level} --o-collapsed-table {output.table} > {log}"

rule qiime_feature_table_filter_samples:
	input:
		table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_collapsed_{P_LEVEL}_table.qza",

		metadata = "data/{APLICON_TYPE}_sample_metadata_file.tsv"
	output:
		filtered_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_filter_table_{P_LEVEL}_{IN_COLUMNS}.qza",
	params:
		p_where = P_WHERE
	log:
		"logs/qiime_ancom/{APLICON_TYPE}_filter_table_{P_LEVEL}_{IN_COLUMNS}.log"
	shell:
		"qiime feature-table filter-samples \
		--i-table {input.table} \
		--m-metadata-file {input.metadata}\
		--p-where {params.p_where} \
		--o-filtered-table {output.filtered_table} > {log}"

rule qiime_feature_table_filter_samples_summarize:
	input:
		filtered_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_filter_table_{P_LEVEL}_{IN_COLUMNS}.qza",

		metadata = "data/{APLICON_TYPE}_sample_metadata_file.tsv"

	output:
		filtered_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_filter_table_{P_LEVEL}_{IN_COLUMNS}.qzv",
	log:
		"logs/qiime_ancom/{APLICON_TYPE}_filter_table_{P_LEVEL}_{IN_COLUMNS}_summrize.log"
	shell:
		"qiime feature-table summarize \
		--i-table {input.filtered_table} \
		--o-visualization {output.filtered_table} \
		--m-sample-metadata-file {input.metadata}"

