import pandas as pd

wildcard_constraints:
	P_LEVEL="\d"

def get_aplication_type(wildcards):

	return wildcards.APLICON_TYPE

def get_minimum_value(filename):
	#filename = rules.qiime_dada2_denoise_paired_feature_table_export.output.table_tsv
	df = pd.read_csv(filename, header = 0, comment = "#")
	print(filename)
	print(int(df['0'].min()))
	return int(df['0'].min())

def get_maxsimum_value(filename):
	#filename = rules.qiime_dada2_denoise_paired_feature_table_export.output.table_tsv
	df = pd.read_csv(filename, header = 0, comment = "#")
	print(filename)
	return int(df['0'].max())

#Ribosome 16S RNA 
#The sequencing of a DNA fraction, begin in both ends. 
#An example for suitable primers for V3-V4 region is: forward sequencing 341F, and reverse 806R. 
#This gene is suitable for bacteria analysis because of sufficient variability among bacteria.
# The diffrence between the Reverse and Forward primers set the minimal length of sequnce which need to be coverded by the merged read.
# For example, min_length = 806 - 341 = 465

#Import fastq – make an artifact 
# import all acceptable files to a folder on the HPC server. Forward and reverse together. 
#use a file metadata i.e., Manifest (qiime term)
# making one file from all the files. an artifact .qza suitable for QIIME2.

"qiime tools import \
--type 'SampleData[PairedEndSequencesWithQuality]' \
--input-path file_metadata.tsv \
--input-format PairedEndFastqManifestPhred33V2 \
--output-path demux-paired-end.qza"

# view the results

#qiime demux summarize \
#  --i-data demux-paired-end.qza \
#  --o-visualization demux.qzv
# drag any .qzv file to the website https://view.qiime2.org/  and see the results.

APLICON_TYPE = config["aplicon_type"]

TREATMENT = config["treatment"]

IN_COLUMNS = config["con_in_columns"]

P_WHERE_COLUMNS = config["con_p_where_columns"]

TREATMENT_IN_COLUMNS = expand("{treatment}_{in_columns}", treatment = TREATMENT, in_columns = IN_COLUMNS)

P_WHERE = expand("\"[{treatment}] IN ({in_columns})\"", treatment = TREATMENT, in_columns = P_WHERE_COLUMNS)

P_LEVEL = config["p_level"]

#dada2 parametrs 

TRIM_LEFT_F = config["trim_left_f"]
TRIM_LEFT_R = config["trim_left_r"]
TRUNC_LEN_F = config["trunc_len_f"]
TRUNC_LEN_R =  config["trunc_len_r"]

#--p-max-ee-f NUMBER     Forward reads with number of expected errors higher
#than this value will be discarded.    [default: 2.0]
#--p-max-ee-r NUMBER     Reverse reads with number of expected errors higher
#than this value will be discarded.    [default: 2.0]
#--p-min-overlap INTEGER The minimum length of the overlap required for
#Range(4, None)        merging the forward and reverse reads. [default: 12]

P_MAX_EE_F = config["p_max_ee_f"]

P_MAX_EE_R = config["p_max_ee_r"]

P_MIN_OVERLAP = config["p_min_overlap"]

CORES =  config["cores"]

#NEW
SAMPLING_DEPTH = config["sampling_depth"]

MAX_DEPTH =  config["max_depth"]

