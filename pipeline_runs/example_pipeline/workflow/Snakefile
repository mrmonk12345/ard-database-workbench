	log:
		"logs/qiime_diversity/{APLICON_TYPE}_taxonomy_table.log" 
	shell:
		"qiime metadata tabulate \
		--m-input-file {input.taxonomy} \
		--o-visualization {output.taxonomy} > {log}"

