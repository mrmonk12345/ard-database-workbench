METADATA_COLUMN = config["treatment"]

rule qiime_diversity_beta_group_significance:
	input:
		metadata = "data/{APLICON_TYPE}_sample_metadata_file.tsv",

		merged = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/merged_out",

		unweighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_distance_matrix.qza",

		weighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_distance_matrix.qza",

		jaccard_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_distance_matrix.qza",

		bray_curtis_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_distance_matrix.qza",

	output:
		unweighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_beta_group_significance.qzv",

		weighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_beta_group_significance.qzv",

		jaccard_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_beta_group_significance.qzv",

		bray_curtis_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_beta_group_significance.qzv",

	params:
		metadata_column =  {METADATA_COLUMN},
	log:
		"logs/qiime_diversity/{APLICON_TYPE}_beta_diversity.log" 
	run:
		shell("touch {output.unweighted_unifrac_distance_matrix}")

		shell("qiime diversity beta-group-significance \
		  --i-distance-matrix {input.unweighted_unifrac_distance_matrix} \
		  --m-metadata-file {input.metadata} \
		  --m-metadata-column {params.metadata_column} \
		  --o-visualization {output.unweighted_unifrac_distance_matrix} \
		  --p-pairwise  > {log} || true")

		shell("touch {output.weighted_unifrac_distance_matrix}")

		shell("qiime diversity beta-group-significance \
		  --i-distance-matrix {input.weighted_unifrac_distance_matrix} \
		  --m-metadata-file {input.metadata} \
		  --m-metadata-column {params.metadata_column} \
		  --o-visualization {output.weighted_unifrac_distance_matrix} \
		  --p-pairwise  > {log} || true")

		shell("touch {output.jaccard_distance_matrix}")

		shell("qiime diversity beta-group-significance \
		  --i-distance-matrix {input.jaccard_distance_matrix} \
		  --m-metadata-file {input.metadata} \
		  --m-metadata-column {params.metadata_column} \
		  --o-visualization {output.jaccard_distance_matrix} \
		  --p-pairwise  > {log} || true")

		shell("touch {output.bray_curtis_distance_matrix}")

		shell("qiime diversity beta-group-significance \
		  --i-distance-matrix {input.bray_curtis_distance_matrix} \
		  --m-metadata-file {input.metadata} \
		  --m-metadata-column {params.metadata_column} \
		  --o-visualization {output.bray_curtis_distance_matrix} \
		  --p-pairwise  > {log} || true")

rule qiime_diversity_beta_group_significance_merege:
	input:
		unweighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_beta_group_significance.qzv",

		weighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_beta_group_significance.qzv",

		jaccard_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_beta_group_significance.qzv",

		bray_curtis_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_beta_group_significance.qzv",
