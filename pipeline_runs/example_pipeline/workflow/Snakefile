#results/{APLICON_TYPE}/qiime_import/{APLICON_TYPE}_per-sample-fastq-counts.tsv

#manuel work
# 1. open demux-paired-end.qzv on chrominum-browser on hpc
#https://view.qiime2.org/
# 2. download per-sample per-sample-fastq-counts.tsv
# 3. mv to results/{APLICON_TYPE}/qiime_import/{APLICON_TYPE}_per-sample-fastq-counts.tsv
# 4. inspect interactive quality plots to  determine parametres for dada2 denosie-pared.
# for 16s amplicon sequncing, min length of merged read is 465.
# choose location on forward (--p-trunc-len-f) and reservse (--p-trunc-len-r) read, starting from the end of the read, such that the quality of solid bars are at most 20. 
# that is the quality from selected locations to the end of the read are less than 20 (are poor quality).
# the required sum of positions needs to be at least 465 (the diffrence between revese and forward primers).
# the forward and reverse primers are trimmed using
#--p-trim-left-f, --p-trim-left-r dada2 parameters respectivly 
# parmeters dada2 
# quality check
# remove primers. in this case f primer is 17, and r primer is 20 bp long.
# connecting forward and reverse files
# makes a table, representative sequences, and statistics.
 
#qiime dada2 denoise-paired \
#  --i-demultiplexed-seqs demux-paired-end.qza \
#  --p-trim-left-f 17 \
#  --p-trim-left-r 20 \
#  --p-trunc-len-f 286 \
#  --p-trunc-len-r 223 \
#  --o-table table.qza \
#  --o-representative-sequences rep-seqs.qza \
#  --o-denoising-stats denoising-stats.qza

#qiime_dada2_denoise-paired


rule qiime_dada2_denoise_paired:
	input:
		"results/{APLICON_TYPE}/qiime_import/{APLICON_TYPE}_demux-paired-end.qza"
	output:
		table = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_table.qza",
		representative_sequences = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_rep_seqs.qza",
		denoising_stats = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_denoising_stats.qza"
	params:
		trim_left_f = TRIM_LEFT_F,
		trim_left_r = TRIM_LEFT_R,
		trunc_len_f = TRUNC_LEN_F,
		trunc_len_r = TRUNC_LEN_R,
		p_max_ee_f = P_MAX_EE_F,
		p_max_ee_r =  P_MAX_EE_R,
		p_min_overlap = P_MIN_OVERLAP,
		#NEW

	threads:
		CORES

	log:
		"logs/qiime_dada2_denoise_paired/{APLICON_TYPE}_qiime_dada2_denoise-paired.log" 
	shell:
		"qiime dada2 denoise-paired \
		--i-demultiplexed-seqs {input} \
		--p-trim-left-f {params.trim_left_f} \
		--p-trim-left-r {params.trim_left_r} \
		--p-trunc-len-f {params.trunc_len_f} \
		--p-trunc-len-r {params.trunc_len_r} \
		--p-max-ee-f {params.p_max_ee_f} \
		--p-max-ee-r {params.p_max_ee_r} \
		--p-min-overlap {params.p_min_overlap} \
	  	--p-n-threads {threads} \
		--o-table {output.table} \
		--o-representative-sequences {output.representative_sequences} \
		--o-denoising-stats {output.denoising_stats} > {log}"


#rep-seqs.qzv  
#one representative sequence for every group of similar sequences.

rule qiime_dada2_denoise_paired_feature_table:
	input:
		representative_sequences = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_rep_seqs.qza"
