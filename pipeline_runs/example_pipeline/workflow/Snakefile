rule qiime_composition_ancom_unzip:
	input:
		ancom_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}.qzv",
	output:
		unziped = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_dummy",

		ancom = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_ancom.tsv",

		data = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_data.tsv",

		abundances = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_abundance.tsv"

	params:
		ancom_dir = "results/{APLICON_TYPE}/qiime_ancom/temp"
	run:
		shell("unzip -jqo {input.ancom_table} -d {params.ancom_dir}")

		shell("mv {params.ancom_dir}/ancom.tsv {output.ancom}")

		shell("mv {params.ancom_dir}/data.tsv {output.data}")

		shell("mv {params.ancom_dir}/percent-abundances.tsv {output.abundances}")

		shell("echo {output.abundances} {output.ancom} {output.data} > {output.unziped}")

		shell("rm -rf {params.ancom_dir}")

rule qiime_composition_ancom_merge:
	input:
		unziped = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_dummy",

		ancom = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_ancom.tsv",

		data = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_data.tsv"
	output:
		out_combined = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_{P_LEVEL}_{IN_COLUMNS}_combined.tsv"

	script:
		'scripts/combine_ancom_res.py'

rule venn_diagram_down_up_table:
	input:
		karkom = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_karkom_level_{P_LEVEL}_combined.tsv",

		tsur_moshe = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_tsur_moshe_level_{P_LEVEL}_combined.tsv",

		hodaya = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_hodaya_level_{P_LEVEL}_combined.tsv",

		beit_itschak = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_ancom_beit_itschak_level_{P_LEVEL}_combined.tsv"
	output:
		out_venn_up = "results/{APLICON_TYPE}/venn_tables/{APLICON_TYPE}_up_level_{P_LEVEL}.tsv",

		out_venn_down = "results/{APLICON_TYPE}/venn_tables/{APLICON_TYPE}_down_level_{P_LEVEL}.tsv"
	script:
		'scripts/create_venn_table.py'
