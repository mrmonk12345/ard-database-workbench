#Taxonomy - find taxonomy for every representative sequence.

#qiime feature-classifier classify-sklearn \
#  --i-classifier ../classifiers/greengenes/gg.classifier.qza \
#  --i-reads rep-seqs.qza \
#   --p-n-jobs
#  --o-classification taxonomy.qza

#qiime metadata tabulate \
#  --m-input-file taxonomy.qza \
#  --o-visualization taxonomy.qzv


rule qiime_feature_classifier_classify_sklearn:
	input:
		classifier = "data/{APLICON_TYPE}_classifier.qza",

		representative_sequences = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_rep_seqs.qza"
	output:
		 taxonomy = "results/{APLICON_TYPE}/qiime_diversity/{APLICON_TYPE}_taxonomy.qza"
	threads:
		CORES
	log:
		"logs/qiime_diversity/{APLICON_TYPE}_taxonomy.log" 
	shell:
		"qiime feature-classifier classify-sklearn \
		--i-classifier {input.classifier} \
		--i-reads {input.representative_sequences} \
		--p-n-jobs {threads} \
		--o-classification {output.taxonomy} > {log}"

rule qiime_metadata_tabulate_taxonomy:
