rule qiime_composition_add_pseudocount:
	input:
		table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_collapsed_{P_LEVEL}_table.qza",

		filtered_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_filter_table_{P_LEVEL}_{IN_COLUMNS}.qzv"

	output:
		comp_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_composition_{P_LEVEL}_table_{IN_COLUMNS}.qza"
	log:
		"logs/qiime_ancom/{APLICON_TYPE}_composition_{P_LEVEL}_table_{IN_COLUMNS}.log"
	shell:
		"qiime composition add-pseudocount \
		--i-table {input.table} \
		--o-composition-table {output.comp_table} > {log}"

rule qiime_feature_table_filter_samples_composition:
	input:
		comp_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_composition_{P_LEVEL}_table_{IN_COLUMNS}.qza",

		metadata = "data/{APLICON_TYPE}_sample_metadata_file.tsv"

	output:
		filtered_table = "results/{APLICON_TYPE}/qiime_ancom/{APLICON_TYPE}_filter_table_composition_{P_LEVEL}_{IN_COLUMNS}.qza"
	params:
		p_where = P_WHERE
	log:
		"logs/qiime_ancom/{APLICON_TYPE}_filter_table_composition_{P_LEVEL}_{IN_COLUMNS}.log"

	shell:
		"qiime feature-table filter-samples \
		--i-table {input.comp_table} \
		--m-metadata-file {input.metadata}\
		--p-where {params.p_where} \
		--o-filtered-table {output.filtered_table} > {log}"

