#Creating a tree for later analysis

#qiime phylogeny align-to-tree-mafft-fasttree \
#  --i-sequences rep-seqs.qza \
#  --o-alignment aligned-rep-seqs.qza \
#  --o-masked-alignment masked-aligned-rep-seqs.qza \
#  --o-tree unrooted-tree.qza \
#  --o-rooted-tree rooted-tree.qza

rule qiime_phylogeny_align_to_tree_mafft_fasttree:
	input:
		representative_sequences = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_rep_seqs.qza"
	
	output:
		aligned_rep_seqs = "results/{APLICON_TYPE}/qiime_phylogeny/{APLICON_TYPE}_aligned_rep_seqs.qza",

		masked_aligned_rep_seqs = "results/{APLICON_TYPE}/qiime_phylogeny/{APLICON_TYPE}_masked_aligned_rep_seqs.qza",

		unrooted_tree = "results/{APLICON_TYPE}/qiime_phylogeny/{APLICON_TYPE}_unrooted_tree.qza",

		rooted_tree = "results/{APLICON_TYPE}/qiime_phylogeny/{APLICON_TYPE}_rooted_tree.qza"
	log:
		"logs/qiime_phylogeny/{APLICON_TYPE}_qiime_phylogeny.log" 
	threads:
		CORES

	shell:
		"qiime phylogeny align-to-tree-mafft-fasttree \
		  --i-sequences {input.representative_sequences} \
	  	  --p-n-threads {threads} \
		  --o-alignment {output.aligned_rep_seqs} \
		  --o-masked-alignment {output.masked_aligned_rep_seqs} \
		  --o-tree {output.unrooted_tree} \
		  --o-rooted-tree {output.rooted_tree} > {log}"

#alpha rarefaction (figures)

# qiime diversity alpha-rarefaction \
#  --i-table table.qza \
#  --i-phylogeny rooted-tree.qza \
#  --p-max-depth 6000 \
#  --m-metadata-file DiuronMF.txt \
#  --o-visualization alpha-rarefaction.qzv


rule qiime_diversity_alpha_rarefaction:
	input:
		metadata = "data/{APLICON_TYPE}_sample_metadata_file.tsv",

		table  = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_table.qza",

		rooted_tree = "results/{APLICON_TYPE}/qiime_phylogeny/{APLICON_TYPE}_rooted_tree.qza",

	output:
		alpha_rarefaction = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/{APLICON_TYPE}_alpha_rarefaction.qzv",


	params:
		#max_depth = get_maxsimum_value(rules)
	log:
		"logs/qiime_diversity/{APLICON_TYPE}_alpha_rarefaction.log" 
	run:
		max_depth = MAX_DEPTH

		shell("qiime diversity alpha-rarefaction \
		  --i-table {input.table} \
		  --i-phylogeny {input.rooted_tree} \
		  --p-max-depth {max_depth} \
		  --m-metadata-file {input.metadata} \
		  --o-visualization {output.alpha_rarefaction} > {log}")


#core-metrics – samples comparisons 
#Creates  pairwise samples comparison matrix tables, PCO data, and alpha diversity data.

#diversity core-metrics-phylogenetic
#95 sampling depth parameter is the minimal non-chimeric from denosing stats

#qiime diversity core-metrics-phylogenetic \
#  --i-phylogeny rooted-tree.qza \
#  --i-table table.qza \
#  --p-sampling-depth 2320 \
#  --m-metadata-file metadata.txt \
#  --output-dir core-metrics-results

rule qiime_diversity_core_metrics_phylogenetic:
	input:
		metadata = "data/{APLICON_TYPE}_sample_metadata_file.tsv",

		table  = "results/{APLICON_TYPE}/qiime_dada2_denoise_paired/{APLICON_TYPE}_table.qza",

		rooted_tree = "results/{APLICON_TYPE}/qiime_phylogeny/{APLICON_TYPE}_rooted_tree.qza"

	output:
		rarefied_table = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/rarefied_table.qza",

		faith_pd_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/faith_pd_vector.qza",

		observed_features_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/observed_features_vector.qza",

		shannon_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/shannon_vector.qza",

		evenness_vector =  "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/evenness_vector.qza",

		unweighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_distance_matrix.qza",

		weighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_distance_matrix.qza",

		jaccard_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_distance_matrix.qza",

		bray_curtis_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_distance_matrix.qza",

		unweighted_unifrac_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_pcoa_results.qza",

		weighted_unifrac_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_pcoa_results.qza",

		jaccard_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_pcoa_results.qza",

		bray_curtis_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_pcoa_results.qza",

		unweighted_unifrac_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_emperor.qzv",

		weighted_unifrac_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_emperor.qzv",

		jaccard_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_emperor.qzv",

		bray_curtis_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_emperor.qzv"
	threads:
		CORES

	log:
		"logs/qiime_diversity/{APLICON_TYPE}_core_metrics_phylogenetic.log" 
	run:
		sampling_depth = SAMPLING_DEPTH

		if sampling_depth == 0 : sampling_depth = 1

		shell("qiime diversity core-metrics-phylogenetic \
		--i-phylogeny {input.rooted_tree} \
		--i-table {input.table} \
		--p-sampling-depth {sampling_depth} \
		--m-metadata-file {input.metadata} \
		--p-n-jobs-or-threads {threads} \
		--o-rarefied-table {output.rarefied_table} \
		--o-faith-pd-vector {output.faith_pd_vector} \
		--o-observed-features-vector {output.observed_features_vector} \
		--o-shannon-vector {output.shannon_vector} \
		--o-evenness-vector {output.evenness_vector} \
		--o-unweighted-unifrac-distance-matrix {output.unweighted_unifrac_distance_matrix} \
		--o-weighted-unifrac-distance-matrix {output.weighted_unifrac_distance_matrix} \
		--o-jaccard-distance-matrix {output.jaccard_distance_matrix} \
		--o-bray-curtis-distance-matrix {output.bray_curtis_distance_matrix} \
		--o-unweighted-unifrac-pcoa-results {output.unweighted_unifrac_pcoa_results} \
		--o-weighted-unifrac-pcoa-results {output.weighted_unifrac_pcoa_results} \
		--o-jaccard-pcoa-results {output.jaccard_pcoa_results} \
		--o-bray-curtis-pcoa-results {output.bray_curtis_pcoa_results} \
		--o-unweighted-unifrac-emperor {output.unweighted_unifrac_emperor} \
		--o-weighted-unifrac-emperor {output.weighted_unifrac_emperor} \
		--o-jaccard-emperor {output.jaccard_emperor} \
		--o-bray-curtis-emperor {output.bray_curtis_emperor} > {log}")


rule qiime_diversity_core_metrics_phylogenetic_merge:
	input:
		rarefied_table = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/rarefied_table.qza",

		faith_pd_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/faith_pd_vector.qza",

		observed_features_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/observed_features_vector.qza",

		shannon_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/shannon_vector.qza",

		evenness_vector =  "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/evenness_vector.qza",

		unweighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_distance_matrix.qza",

		weighted_unifrac_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_distance_matrix.qza",

		jaccard_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_distance_matrix.qza",

		bray_curtis_distance_matrix = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_distance_matrix.qza",

		unweighted_unifrac_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_pcoa_results.qza",

		weighted_unifrac_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_pcoa_results.qza",

		jaccard_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_pcoa_results.qza",

		bray_curtis_pcoa_results = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_pcoa_results.qza",

		unweighted_unifrac_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/unweighted_unifrac_emperor.qzv",

		weighted_unifrac_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/weighted_unifrac_emperor.qzv",

		jaccard_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/jaccard_emperor.qzv",

		bray_curtis_emperor = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/bray_curtis_emperor.qzv"
	output:
		"results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/merged_out"

	shell:
		"echo \
		 {input.rarefied_table} \
		 {input.faith_pd_vector} \
		 {input.observed_features_vector} \
		 {input.shannon_vector} \
		 {input.evenness_vector} \
		 {input.unweighted_unifrac_distance_matrix} \
		 {input.weighted_unifrac_distance_matrix} \
		 {input.jaccard_distance_matrix} \
		 {input.bray_curtis_distance_matrix} \
		 {input.unweighted_unifrac_pcoa_results} \
		 {input.weighted_unifrac_pcoa_results} \
		 {input.jaccard_pcoa_results} \
		 {input.bray_curtis_pcoa_results} \
		 {input.unweighted_unifrac_emperor} \
		 {input.weighted_unifrac_emperor} \
		 {input.jaccard_emperor} \
		 {input.bray_curtis_emperor} > {output}"

#alpha-diversity - comparison alpha-diversity indexes among tratments.

#qiime diversity alpha-group-significance \
#  --i-alpha-diversity core-metrics-results/faith_pd_vector.qza \
#  --m-metadata-file MF.ATZ.txt \
#  --o-visualization core-metrics-results/faith-pd-group-significance.qzv

rule diversity_alpha_group_significance:
	input:
		metadata = "data/{APLICON_TYPE}_sample_metadata_file.tsv",

		merged = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/merged_out",

		faith_pd_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/faith_pd_vector.qza",

		observed_features_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/observed_features_vector.qza",

		evenness_vector =  "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/evenness_vector.qza",

		shannon_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/shannon_vector.qza",

	output:
		faith_pd_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/faith_pd_group_significance.qzv",

		observed_features_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/observed_features_vector_group_significance.qzv",

		evenness_vector =  "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/evenness_vector_group_significance.qzv",

		shannon_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/shannon_vector_group_significance.qzv",

	run:
		shell("touch {output.faith_pd_vector}")

		shell(
		"qiime diversity alpha-group-significance \
		--i-alpha-diversity {input.faith_pd_vector} \
		--m-metadata-file {input.metadata} \
		--o-visualization {output.faith_pd_vector} || true")

		shell("touch {output.observed_features_vector}")

		shell(
		"qiime diversity alpha-group-significance \
		--i-alpha-diversity {input.observed_features_vector} \
		--m-metadata-file {input.metadata} \
		--o-visualization {output.observed_features_vector} || true")

		shell("touch {output.evenness_vector}")

		shell(
		"qiime diversity alpha-group-significance \
		--i-alpha-diversity {input.evenness_vector} \
		--m-metadata-file {input.metadata} \
		--o-visualization {output.evenness_vector} || true")

		shell("touch {output.shannon_vector}")

		shell(
		"qiime diversity alpha-group-significance \
		--i-alpha-diversity {input.shannon_vector} \
		--m-metadata-file {input.metadata} \
		--o-visualization {output.shannon_vector} || true")

rule diversity_alpha_group_significance_merege:
	input:
		faith_pd_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/faith_pd_group_significance.qzv",

		observed_features_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/observed_features_vector_group_significance.qzv",

		evenness_vector =  "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/evenness_vector_group_significance.qzv",

		shannon_vector = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/shannon_vector_group_significance.qzv",

	output:
		merge = "results/{APLICON_TYPE}/qiime_diversity/core_metrics_phylogenetic/{APLICON_TYPE}_diversity_alpha_group_significance_merege.txt"

	run:
		shell("echo {input.faith_pd_vector} {input.observed_features_vector} {input.evenness_vector} {input.shannon_vector} > {output.merge}")




