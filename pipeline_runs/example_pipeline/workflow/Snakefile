	log:
		"logs/qiime_dada2_denoise_paired/{APLICON_TYPE}_qiime_dada2_denoise-paired_feature_table.log" 
	shell:
		"qiime feature-table tabulate-seqs \
		--i-data {input.representative_sequences} \
		--o-visualization {output.representative_sequences} > {log}"

